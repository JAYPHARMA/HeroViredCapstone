  "cards": [
    {
      "dot": "cyan",
      "title": "Reproducible research, separate from inference",
      "items": [
        "Pinned dataset revision and seed 42; original training has 6,241 rows.",
        "Twelve conflicting rows are quarantined and one further duplicate removed.",
        "Saved artifacts feed both inference interfaces; opening the app does not retrain."
      ]
    },
    {
      "dot": "emerald",
      "title": "What improved on the held-out test",
      "items": [
        "TF-IDF + Random Forest: accuracy 46.73%; macro F1 0.3626; NDCG@3 0.6150.",
        "Sentence-BERT + logistic: accuracy 47.92%; macro F1 0.4489; NDCG@3 0.6910.",
        "Configuration selection uses validation macro F1, never test labels. Encoder stays frozen."
      ]
    },
    {
      "dot": "rose",
      "title": "What the evaluation does not establish",
      "items": [
        "Original test CSV stays separate; test labels are used only for evaluation.",
        "Test JDs and exact pairs are unseen, but resumes in 1,758 of 1,759 test pairs recur in training.",
        "Accuracy is below the 48.72% majority baseline; unseen-candidate validity and fairness remain unproven."
      ]
    }
  ]

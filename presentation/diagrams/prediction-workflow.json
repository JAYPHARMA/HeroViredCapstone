  "cards": [
    {
      "dot": "cyan",
      "title": "Two entry points, one Python matcher",
      "items": [
        "Streamlit calls the matcher directly; it does not call the FastAPI server.",
        "FastAPI POST /match returns JSON. Streamlit displays results and exports CSV.",
        "Logical inference stages are shown, not separate network services."
      ]
    },
    {
      "dot": "emerald",
      "title": "Saved weights; no training during a request",
      "items": [
        "Startup loads models/resume_matcher.joblib; MiniLM loads from models/encoder on CPU.",
        "Up to eight evenly spaced 150-word chunks are pooled; encoder token limit is 256.",
        "Pair input: r, j, |r-j|, r*j, embedding cosine and eight lexical/skill features."
      ]
    },
    {
      "dot": "rose",
      "title": "Explain the limits in the viva",
      "items": [
        "Fit category is separate from ranking; neither score is a calibrated hiring probability.",
        "Keyword gaps and semantic paraphrase suggestions are evidence to verify, not proof of proficiency.",
        "Short inputs and keyword stuffing can fail. Human review is required."
      ]
    }
  ]
